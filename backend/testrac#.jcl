//TESTRAC# JOB  (AXX,BXX,CXX),
//          CLASS=A,MSGLEVEL=(1,1),
//          USER=HERC01,PASSWORD=CUL8TR,
//          MSGCLASS=X,NOTIFY=&SYSUID
//ASM   EXEC PGM=IFOX00,PARM=(NOOBJECT,DECK,XREF)
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=SYS2.MACLIB,DISP=SHR
//         DD DSN=SYS1.AMODGEN,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSLIN   DD DUMMY
//SYSGO    DD DUMMY
//SYSIN    DD *
         START 0
         REGISTER
TESTRAC  CSECT
         SAVE  (14,12)
         BALR  R12,0
         USING *,R12
         ST    13,SAVEAREA+4
         LA    14,SAVEAREA
         ST    14,8(13)
         LR    13,14
         ST    R14,SAVE14
         LA    R1,PARMS
         SR    R15,R15
         L     R15,=V(RAKFCHK)
         BALR  R14,R15
         ST    R15,SAVE15
         WTO   'BACK FROM RAKF CHECK'
         MVC   RETCODE(8),FUNCTION
         WTO   MF=(E,WTOGRP)
         L     R14,SAVE14
         L     R13,4(,R13)
         LM    R14,R12,12(R13)
         SR    R15,R15
         BR    R14
         LTORG ,
         DS    0F
SAVE14   DS    F
SAVE15   DS    F
         DS    0F
PARMS    EQU *
         DC    A(FUNCTION)
         DC    A(GROUPNAM)
         DC    A(USERID+X'80000000')
         DS    0F
FUNCTION DC  CL8'PWCHECK '
GROUPNAM DC  CL8'TOPSEC  '
USERID   DC  CL8'USERID  '
         DS  0F
WTOGRP   DC  AL2(WTOGRPL)
         DC  XL2'0000'
         DC  CL8'RETCODE='
RETCODE  DC  CL8'        '
WTOGRPL  EQU *-WTOGRP
         DS  0F
DATAAREA DS  0F
SAVEAREA DC  18F'0'
         END
*/
//SYSLIN   DD DUMMY
//SYSPUNCH DD DSN=EKATUS.TEST.OBJLIB(TESTRAC),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//LINKSTUB EXEC PGM=IEWL,PARM='XREF,LIST,LET,MAP,AC=1'
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(1024,(200,20))
//MYOBJ    DD DISP=SHR,DSN=EKATUS.TEST.OBJLIB
//SYSLIB   DD DISP=SHR,DSN=EKATUS.LOADLIB(RAKFCHK)
//SYSLMOD  DD DISP=SHR,DSN=EKATUS.LOADLIB(TESTRAC)
//SYSLIN   DD *
 INCLUDE MYOBJ(TESTRAC)
 ENTRY TESTRAC
 NAME TESTRAC(R)
/*
//GO       EXEC PGM=TESTRAC,REGION=4M
//STEPLIB  DD   DSN=EKATUS.LOADLIB,DISP=SHR
//SYSOUT   DD   SYSOUT=*
//SYSUDUMP DD   SYSOUT=*
//SYSPRINT DD   SYSOUT=*
