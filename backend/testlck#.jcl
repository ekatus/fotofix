//TESTLCK# JOB  (AXX,BXX,CXX),
//          CLASS=A,MSGLEVEL=(1,1),
//          MSGCLASS=X,NOTIFY=&SYSUID
//ASM   EXEC PGM=IFOX00,PARM=(OBJECT,NODECK,XREF)
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=SYS2.MACLIB,DISP=SHR
//         DD DSN=SYS1.AMODGEN,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSLIN   DD DUMMY
//SYSPUNCH DD DUMMY
//SYSLIN   DD DUMMY
//SYSGO    DD DSN=EKATUS.TEST.OBJLIB(TESTLCK),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
         REGISTER
TESTLCK  CSECT
*        SAVE  (14,12)
         STM   R14,R12,12(R13)    * R13 = SAVEAREA OF CALLER
         BALR  R12,0
         USING *,R12
         ST    R13,SAVEAREA+4     * STORE R13 INTO 2ND FULL WORD OF
         LA    R14,SAVEAREA       * OWN SAVEAREA. LOAD R14 WITH SA
         ST    R14,8(R13)         * STORE A(SA) TO 3RD FULL WORD OF
         LR    R13,R14            * CALLER SA, LOAD OWN SA INTO R13
         OPEN  (SNAPDCB,(OUTPUT))
         WTO   'CALLING MVSLOCK'
         LA    R1,PARMSE          * LOAD ADDR OF PARM LIST R1
         SR    R15,R15
         L     R15,=V(MVSLOCK)    * LINK ADDR SUBPROG R15
         BALR  R14,R15            * BRANCH AND LINK, RETURN R14
         ST    R15,SUBRC          * SAVE ERROR CODE FROM SUBPROG
         SNAP  DCB=SNAPDCB,ID=1,PDATA=(REGS),STORAGE=(SUBRC,SUBRC+4)
         LTR   R15,R15
         BAL   R14,DUMPR15        * LINK DUMPR15
         ST    R14,SAVE14
         WTO   'BACK FROM MVSLOCK ENQ'
         L     R14,SAVE14
         L     R15,SUBRC
         LTR   R15,R15
         BNZ   ENQERR
         LA    R1,PARMSD          * LOAD ADDR OF PARM LIST R1
         SR    R15,R15
         XC    SUBRC,SUBRC
         L     R15,=V(MVSLOCK)
         BALR  R14,R15            * BRANCH AND LINK SUBPROG
         ST    R15,SUBRC          * SAVE ERROR CODE FROM SUBPROG
         SNAP  DCB=SNAPDCB,ID=2,PDATA=(REGS),STORAGE=(SUBRC,SUBRC+4)
         BAL   R14,DUMPR15        * LINK DUMPR15
         WTO   'BACK FROM MVSLOCK DEQ'
         L     R15,SUBRC
         LTR   R15,R15
         BNZ   DEQERR
         B     EXIT
ENQERR   EQU   *
         WTO   'ERROR PERFORMING ENQ'
         B     EXIT
DEQERR   EQU   *
         WTO   'ERROR PERFORMING DEQ'
EXIT     EQU   *
         WTO   'EXIT PROGRAM'
         CLOSE (SNAPDCB)
         L     R13,4(,R13)        * LOAD R13 FROM SAVEAREA
         LM    R14,R12,12(R13)    * RESTORE REGISTERS
         SR    R15,R15            * ZERO RETURN CODE
         BR    R14                * BRANCH TO CALLER
DUMPR15  EQU   *
         UNPK  WORK9(9),SUBRC(5)
         TR    WORK9(8),HEXTAB
         MVC   WTOR15D(8),WORK9
         ST    R14,SAVE14
         WTO   MF=(E,WTOR15)
         L     R14,SAVE14
         BR    R14
*
         DS    0F
SAVE14   DS    F
SAVE15   DS    F
PAD1     DC    XL2'0000'
SUBRC    DS    F
PAD2     DC    XL2'0000'
         DS    0F
SNAPDCB  DCB   DSORG=PS,RECFM=VBA,LRECL=125,BLKSIZE=1632,              X
               DDNAME=SNAPDD,MACRF=(W)
         DS    0F
PARMSE   EQU *
         DC    A(ENQFUNC)
         DC    A(DDNAME)
         DC    A(DSNAME+X'80000000')
         DS    0F
PARMSD   EQU *
         DC    A(DEQFUNC)
         DC    A(DDNAME)
         DC    A(DSNAME+X'80000000')
         DS    0F
WTOR15   DC    AL2(WTOR15L)
         DC    XL2'0000'
         DC    CL4'R15='
WTOR15D  DC    CL8'#########'
WTOR15L  EQU   *-WTOR15
         DS    0F
WORK9    DC    CL9'000000000'
         DS    0F
HEXTAB   EQU   *-X'F0'
         DC  C'01234567890ABCDEF'
         DS  0F
ENQFUNC  DC  CL1'E'
DEQFUNC  DC  CL1'D'
DDNAME   DC  CL8'FFIXORD '
DSNAME   DC  CL44'FOTOFIX.ORDERBK.CLUSTER'
         DS  0F
DATAAREA DS  0F
SAVEAREA DC  18F'0'
         LTORG
         END
*/
//LINKSTUB EXEC PGM=IEWL,PARM='XREF,LIST,LET,MAP'
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(1024,(200,20))
//MYOBJ    DD DSN=EKATUS.TEST.OBJLIB,DISP=SHR
//**SLIB   DD DISP=SHR,DSN=EKATUS.TEST.OBJLIB(MVSLOCK)
//SYSLMOD  DD DISP=SHR,DSN=EKATUS.LOADLIB(TESTLCK)
//SYSLIN   DD *
 INCLUDE MYOBJ(TESTLCK)
 INCLUDE MYOBJ(MVSLOCK)
 ENTRY TESTLCK
 NAME TESTLCK(R)
/*
//GO       EXEC PGM=TESTLCK,REGION=4M
//STEPLIB  DD   DSN=EKATUS.LOADLIB,DISP=SHR
//SNAPDD   DD   SYSOUT=*
//SYSOUT   DD   SYSOUT=*
//SYSUDUMP DD   SYSOUT=*
//SYSPRINT DD   SYSOUT=*
